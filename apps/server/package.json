{
  "name": "@zenith-admin/server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "node scripts/check-schema-comments.cjs && node scripts/check-permissions.cjs && nest build",
    "check:schema-comments": "node scripts/check-schema-comments.cjs",
    "check:schema-comments:db": "node scripts/check-schema-comments.cjs --db",
    "check:permissions": "node scripts/check-permissions.cjs",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@e965/xlsx": "0.20.3",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/typeorm": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "exceljs": "4.4.0",
    "mysql2": "^3.15.3",
    "pinyin-pro": "^3.28.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
